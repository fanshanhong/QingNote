<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/spacing_m">

    <!-- 行 1：B / I / U / S -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_style_bold"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_bold"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_style_italic"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_italic"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/btn_style_underline"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_underline" />

        <TextView
            android:id="@+id/btn_style_strike"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_strike" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 行 2：A- / A / A+ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_style_size_small"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_size_small"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_style_size_normal"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_size_normal" />

        <TextView
            android:id="@+id/btn_style_size_large"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_size_large"
            android:textSize="20sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 行 3：5 色圆点 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_style_color_black"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/color_black"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_color_dot"
            app:tint="@color/text_color_black" />

        <ImageView
            android:id="@+id/btn_style_color_red"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/color_red"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_color_dot"
            app:tint="@color/text_color_red" />

        <ImageView
            android:id="@+id/btn_style_color_yellow"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/color_yellow"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_color_dot"
            app:tint="@color/text_color_yellow" />

        <ImageView
            android:id="@+id/btn_style_color_green"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/color_green"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_color_dot"
            app:tint="@color/text_color_green" />

        <ImageView
            android:id="@+id/btn_style_color_blue"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/color_blue"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_color_dot"
            app:tint="@color/text_color_blue" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 行 4：H1 / H2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_style_h1"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_h1" />

        <TextView
            android:id="@+id/btn_style_h2"
            style="@style/EditorToolbarBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/tb_h2" />
    </LinearLayout>

</LinearLayout>
